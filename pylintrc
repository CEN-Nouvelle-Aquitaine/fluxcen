# Configuration pylint pour FluxCEN.
# Minimaliste : ne contient que les overrides nécessaires.
# Le reste utilise les defaults pylint modernes.

[MAIN]
# Exclure les fichiers générés et les répertoires hérités du template Plugin Builder.
ignore-paths=
    ^resources\.py$,
    ^pydev/,
    ^third_party/,
    ^ui/,
    ^conf\.py$

[MESSAGES CONTROL]
# locally-disabled : éviter le warning sur les pylint:disable inline.
# C0103 : nommage trop strict pour le code QGIS legacy
#         (camelCase imposé sur les surcharges Qt).
disable=
    locally-disabled,
    C0103

[FORMAT]
max-line-length=120

[EXCEPTIONS]
overgeneral-exceptions=builtins.Exception
